# Docker: not needed — `docker compose up` works without a .env file.
#         Create one only for push notifications (VAPID keys).
# npm run dev: copy this file to .env and fill in the values.

MONGO_URI=mongodb://localhost:27017/cleaning
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# VAPID keys for web push notifications.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
